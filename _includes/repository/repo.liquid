{% comment %}
  A repository card rendered from _data/repositories.yml.

  This used to pull a PNG from github-readme-stats.vercel.app, which is a
  third-party service and is currently returning 503 DEPLOYMENT_PAUSED — so the
  cards rendered as broken images. Everything here is local.

  Usage: {% include repository/repo.liquid repository=repo %}
{% endcomment %}

{% assign repo = include.repository %}

<a class="repo-card" href="{{ repo.url }}" target="_blank" rel="noopener noreferrer">
  <div class="repo-card-head">
    {% if repo.host == 'gitlab' %}
      <i class="fa-brands fa-gitlab" aria-hidden="true"></i>
    {% else %}
      <i class="fa-brands fa-github" aria-hidden="true"></i>
    {% endif %}
    <span class="repo-card-owner">{{ repo.owner }}/</span><wbr><span class="repo-card-name">{{ repo.name }}</span>
  </div>
  {% if repo.description %}
    <p class="repo-card-desc">{{ repo.description }}</p>
  {% endif %}
  {% if repo.language %}
    <p class="repo-card-lang">{{ repo.language }}</p>
  {% endif %}
</a>
